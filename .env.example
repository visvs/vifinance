# =============================================================================
# Variables de entorno de ViFinance
# =============================================================================
# En desarrollo local: corre `pnpm supabase start` y usa la URL y llave
# publicable que imprime el comando.
#
# En producción: Project Settings → API en el panel de Supabase.
# =============================================================================

# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Llave publicable (empieza con `sb_publishable_` o es la ANON legacy).
# Es segura de exponer al navegador: el RLS decide qué se ve.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
